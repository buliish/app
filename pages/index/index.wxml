<!--index.wxml-->
<view class="page">
  <scroll-view class="chat-area" scroll-y scroll-with-animation scroll-into-view="{{scrollToView}}">
    <view class="messages">
      <block wx:for="{{messages}}" wx:key="id">
        <view id="msg-{{item.id}}" class="message-row {{item.sender}}">
          <view class="bubble {{item.sender}}">
            <text>{{item.text}}</text>
          </view>
        </view>
        <view wx:if="{{item.sender === 'bot' && item.suggestions && item.suggestions.length}}" class="suggestion-row">
          <block wx:for="{{item.suggestions}}" wx:key="*this">
            <button class="suggestion-btn" data-question="{{item}}" bindtap="onSuggestionTap">{{item}}</button>
          </block>
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="composer">
    <view class="input-wrapper">
      <input
        class="chat-input"
        placeholder="请输入消息..."
        cursor-spacing="20"
        confirm-type="send"
        bindconfirm="onSend"
        bindinput="onInputChange"
        value="{{inputValue}}"
      />
      <button class="send-btn" hover-class="none" bindtap="onSend">
        <image class="send-icon" src="{{sendIcon}}" mode="aspectFit"></image>
      </button>
    </view>
  </view>
</view>
