/* pages/payModal/payModal.wxss */
.pay-modal-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}

.mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.pay-modal {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 30rpx;
  max-height: 80vh;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.pay-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.pay-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.pay-amount {
  text-align: center;
  margin-bottom: 40rpx;
}

.amount-label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.amount-value {
  display: block;
  font-size: 56rpx;
  color: #333;
  font-weight: bold;
}

.pay-method {
  margin-bottom: 40rpx;
}

.method-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background-color: #f8f8f8;
  border-radius: 16rpx;
}

.method-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
}

.method-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.method-check {
  font-size: 32rpx;
  color: #0C34BA;
  font-weight: bold;
}

.password-section {
  margin-bottom: 40rpx;
}

.password-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.password-input-container {
  position: relative;
  margin-bottom: 20rpx;
}

.password-input {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100rpx;
  opacity: 0;
  z-index: 10;
}

.password-dots {
  display: flex;
  justify-content: space-between;
  height: 100rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
}

.password-dot {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.password-dot::after {
  content: '';
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: transparent;
  border: 2rpx solid #e0e0e0;
  transition: all 0.2s;
}

.password-dot.filled::after {
  background-color: #333;
  border-color: #333;
}

.password-dot.active::after {
  border-color: #0C34BA;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 50% {
    opacity: 1;
  }
  51%, 100% {
    opacity: 0.3;
  }
}

.password-hint {
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.pay-actions {
  display: flex;
  gap: 20rpx;
}

.cancel-btn,
.confirm-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.cancel-btn {
  background-color: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background-color: #0C34BA;
  color: #fff;
}

.cancel-btn::after,
.confirm-btn::after {
  border: none;
}

