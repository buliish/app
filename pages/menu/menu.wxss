page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.page {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.menu{
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

/** 搜素 **/
.search-box{
  height: 68rpx;
  background-color: #fff;
  padding:20rpx;
}

.search-ipt-box{
  background-color: #f2f2f2;
  height: 68rpx;
  border-radius: 34rpx;
  padding: 0 34;
  display: flex;
  align-items: center;
}
.search-icon{
  width:48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}
.search-ipt{
  width: calc(100% - 68rpx);
  height: 68rpx;
  font-size: 28rpx;
}

/** 商品 **/
.menu-content{
  display: flex;
  height: calc(100% - 100rpx);
}

.type{
  width: 160rpx;
  height: 100%;
  overflow-y: auto;
}

.list{
  width: calc(100%-160rpx);
  height: 100%;
  background-color: #fff;
  overflow-y: auto;
  padding: 0 20rpx;
}

.type-item{
  height: 100rpx;
  font-size: 28rpx;
  text-align: center;
  line-height: 100rpx;
  position: relative;
}

.line{
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  margin: auto 0;
  width: 6rpx;
  height: 60rpx;
  background-color: #0C34BA;
  display: none;
}

.type-item.active{
  background-color: rgba(12,52,186,0.25);
}

.type-item.active .line{
  display: block;
}

.list-box{
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding-bottom: 20rpx;
}

.list-item{
  width: calc(50% - 10rpx);
}