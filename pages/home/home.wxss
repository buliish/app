/* 页面容器 - 使用统一主题色 */
.home-container {
  width: 100%;
  box-sizing: border-box;
  background-color: #F8F8F8; /* 统一背景色 */
  min-height: 100vh;
  padding-bottom: 32rpx; /* 统一底部间距 */
}

/* 搜索栏容器 */
.search-bar-wrapper {
  position: relative;
  z-index: 100;
  padding: 16rpx 32rpx; /* 统一页面边距 */
}

/* 搜索栏 - 统一主题样式 */
.search-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 48rpx; /* 统一圆角 */
  padding: 20rpx 32rpx; /* 统一内边距 */
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid rgba(12, 52, 186, 0.1); /* 主题色边框 */
}
.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx; /* 统一间距 */
}
.search-input {
  font-size: 28rpx; /* 统一字体大小 */
  color: #333333;
  flex: 1;
  height: 100%;
}

/* 搜索历史面板 - 统一主题样式 */
.search-history-panel {
  position: absolute;
  top: 100%;
  left: 32rpx; /* 统一边距 */
  right: 32rpx;
  background: #FFFFFF;
  border-radius: 16rpx; /* 统一圆角 */
  margin-top: 12rpx; /* 统一间距 */
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  max-height: 600rpx;
  overflow-y: auto;
  z-index: 101;
  border: 1rpx solid rgba(12, 52, 186, 0.1); /* 主题色边框 */
}

/* AI智能推荐区域 */
.ai-suggestions {
  padding: 24rpx 32rpx; /* 统一内边距 */
  border-bottom: 1rpx solid #F0F0F0;
}

.ai-suggestions-title {
  font-size: 26rpx; /* 统一字体大小 */
  color: #666666;
  margin-bottom: 16rpx; /* 统一间距 */
  font-weight: 500;
}

.ai-suggestions-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx; /* 统一间距 */
}

/* AI智能推荐标签样式 */
.ai-suggestion-tag {
  display: inline-block;
  padding: 12rpx 20rpx; /* 统一内边距 */
  background: linear-gradient(135deg, #0C34BA 0%, #1a4fd4 100%);
  color: #FFFFFF;
  border-radius: 24rpx; /* 统一圆角 */
  font-size: 24rpx; /* 统一字体大小 */
  border: none;
  line-height: 1;
}

.ai-suggestion-tag:active {
  opacity: 0.8;
}

/* 历史记录头部 - 统一样式 */
.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx; /* 统一内边距 */
  border-bottom: 1rpx solid #F0F0F0;
}

.history-title {
  font-size: 28rpx; /* 统一字体大小 */
  font-weight: bold;
  color: #333333;
}

.clear-all-btn {
  font-size: 24rpx;
  color: #0C34BA; /* 使用主题色 */
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.clear-all-btn:active {
  background-color: rgba(12, 52, 186, 0.1);
}

/* 历史记录列表 - 统一间距 */
.history-list {
  padding: 8rpx 0;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx; /* 统一内边距 */
  border-bottom: 1rpx solid #F5F5F5;
  transition: background-color 0.2s;
}

.history-item:active {
  background-color: rgba(12, 52, 186, 0.05); /* 主题色点击效果 */
}

.history-item:last-child {
  border-bottom: none;
}

.history-text {
  flex: 1;
  font-size: 28rpx; /* 统一字体大小 */
  color: #333333;
}

.delete-icon {
  width: 44rpx; /* 统一尺寸 */
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 32rpx;
  color: #999999;
  border-radius: 50%;
}

.delete-icon:active {
  background-color: rgba(0, 0, 0, 0.05);
}

/* 遮罩层 - 统一透明度 */
.history-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 99;
}

/* 轮播组件 - 统一间距 */
.swiper-wrap {
  width: 100%;
  height: 360rpx;
  margin: 24rpx auto; /* 统一上下间距 */
  border-radius: 16rpx; /* 统一圆角 */
  overflow: hidden;
}
.banner-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 商品网格布局 - 统一间距和对齐 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 32rpx; /* 统一页面边距 */
  gap: 16rpx; /* 统一商品间距 */
}
.product-item {
  width: calc(50% - 8rpx); /* 考虑gap间距 */
  box-sizing: border-box;
}

/* 空数据提示 - 统一样式 */
.empty-tip {
  width: 100%;
  text-align: center;
  font-size: 28rpx; /* 统一字体大小 */
  color: #999999;
  padding: 80rpx 0; /* 统一内边距 */
}