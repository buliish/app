/* components/Stepper/Stepper.wxss */
.stepper-container {
  display: flex;
  align-items: center;
}

.stepper-btn {
  width: 50rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  background-color: #f5f5f5;
  border: 1rpx solid #ddd;
  border-radius: 4rpx;
  font-size: 32rpx;
  color: #333;
}

.stepper-btn.reduce {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
}

.stepper-btn.add {
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
}

.stepper-value {
  min-width: 80rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  border-top: 1rpx solid #ddd;
  border-bottom: 1rpx solid #ddd;
  font-size: 28rpx;
  color: #333;
}

