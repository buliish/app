<!--pages/orderDetail/orderDetail.wxml-->
<view class="order-detail-container">
  <!-- 订单状态 -->
  <view class="order-status-bar {{order.status}}">
    <view class="status-icon">
      <text wx:if="{{order.status === 'pending'}}">⏰</text>
      <text wx:if="{{order.status === 'delivering'}}">🚚</text>
      <text wx:if="{{order.status === 'completed'}}">✓</text>
      <text wx:if="{{order.status === 'cancelled'}}">✗</text>
    </view>
    <view class="status-text">{{order.statusText}}</view>
    <view class="status-desc" wx:if="{{order.status === 'pending'}}">请在30分钟内完成支付</view>
    <view class="status-desc" wx:if="{{order.status === 'delivering'}}">商品正在配送中，请耐心等待</view>
    <view class="status-desc" wx:if="{{order.status === 'completed'}}">订单已完成，感谢您的购买</view>
    <view class="status-desc" wx:if="{{order.status === 'cancelled'}}">订单已取消</view>
  </view>

  <!-- 收货地址 -->
  <view class="address-section" wx:if="{{order.address}}">
    <view class="section-header">
      <view class="section-title">收货地址</view>
      <view 
        class="change-address-btn" 
        wx:if="{{order.status === 'pending'}}"
        bindtap="changeAddress"
      >
        修改
      </view>
    </view>
    <view class="address-content">
      <view class="address-info">
        <text class="address-name">{{order.address.name}}</text>
        <text class="address-phone">{{order.address.phone}}</text>
      </view>
      <text class="address-detail">{{order.address.fullAddress || (order.address.regionText + ' ' + order.address.detailAddress)}}</text>
    </view>
  </view>

  <!-- 商品信息 -->
  <view class="products-section">
    <view class="section-title">商品信息</view>
    <view class="product-item" wx:for="{{order.products}}" wx:key="pid">
      <image class="product-img" src="{{item.smallImg}}" mode="aspectFill"></image>
      <view class="product-info">
        <view class="product-name">{{item.name}}</view>
        <view class="product-spec">
          <text class="product-price">¥{{item.price}}</text>
          <text class="product-count">x{{item.count}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="order-info-section">
    <view class="section-title">订单信息</view>
    <view class="info-item">
      <text class="info-label">订单号</text>
      <text class="info-value">{{order.orderNo}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">下单时间</text>
      <text class="info-value">{{order.createTime}}</text>
    </view>
    <view class="info-item" wx:if="{{order.updateTime !== order.createTime}}">
      <text class="info-label">更新时间</text>
      <text class="info-value">{{order.updateTime}}</text>
    </view>
  </view>

  <!-- 价格明细 -->
  <view class="price-section">
    <view class="price-item">
      <text class="price-label">商品总额</text>
      <text class="price-value">¥{{order.totalPrice}}</text>
    </view>
    <view class="price-item">
      <text class="price-label">运费</text>
      <text class="price-value">¥0.00</text>
    </view>
    <view class="price-total">
      <text class="total-label">实付金额</text>
      <text class="total-price">¥{{order.totalPrice}}</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar" wx:if="{{order.status === 'pending' || order.status === 'delivering'}}">
    <button 
      class="action-btn cancel-btn" 
      wx:if="{{order.status === 'pending'}}"
      bindtap="cancelOrder"
    >
      取消订单
    </button>
    <button 
      class="action-btn primary-btn" 
      wx:if="{{order.status === 'pending'}}"
      bindtap="payOrder"
    >
      去付款
    </button>
    <button 
      class="action-btn primary-btn" 
      wx:if="{{order.status === 'delivering'}}"
      bindtap="confirmReceive"
    >
      确认收货
    </button>
  </view>
</view>

