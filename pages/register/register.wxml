<view class="login-container">
  <!-- logo区域 -->
  <view class="logo-wrap">
    <image class="logo-img" src="../../images/home_active.png"></image>
    <text class="logo-text">Luckin Coffee</text>
  </view>

  <!-- 输入区域 -->
  <view class="input-wrap">
    <!-- 手机号输入 -->
    <view class="input-row">
      <text class="input-label">手机号</text>
      <input 
        class="input-field" 
        placeholder="输入手机号" 
        type="number" 
        model:value="{{phone}}"
        maxlength="11"
      />
    </view>

    <!-- 密码输入 -->
    <view class="input-row">
      <text class="input-label">密码</text>
      <view class="password-wrap">
        <input 
          class="input-field-pwd" 
          placeholder="输入密码" 
          password="{{!showPassword}}" 
          model:value="{{password}}"
          maxlength="16"
        />
        <image 
          class="eye-icon" 
          src="../../images/{{showPassword ? 'home_active' : 'home'}}.png"
          mode="widthFix"
          bind:tap="togglePasswordStatus"
        ></image>
      </view>
    </view>

    <!-- 昵称输入 -->
    <view class="input-row">
      <text class="input-label">昵称</text>
      <input 
        class="input-field" 
        placeholder="输入昵称" 
        model:value="{{nickname}}"
        maxlength="16"
      />
    </view>
  </view>

  <!-- 注册按钮 -->
  <view class="login-btn-wrap">
    <button class="login-btn" bind:tap="register">注册</button>
  </view>

  <!-- 辅助链接 -->
  <view class="link-wrap">
    <text class="link-item" bind:tap="goLogin">已有账号，去登录</text>
  </view>

  <!-- 提示信息 -->
  <view class="tips-wrap">
    <text class="tips-title">提示:</text>
    <text class="tips-content">1、手机号为11位有效号码。</text>
    <text class="tips-content">2、密码由数字、字母组合，且必须以字母开头，6-16位。</text>
    <text class="tips-content">3、昵称由中英文组合，1-16位，不含特殊字符。</text>
  </view>
</view>