<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  批发商产品批号：关联映射
  多对一：多条批发商批号（whol_batch）可能归属同一家下游零售商（node_info）。
  与 FrozBatchMapper.xml 同构，仅表名与主键列不同。
-->
<mapper namespace="com.gec.seafood_traceability_system.mapper.WholBatchMapper">

    <resultMap id="DownConfirmMap" type="com.gec.seafood_traceability_system.pojo.ConfirmVO">
        <id property="id" column="whol_batch_id"/>
        <result property="downNodeId" column="node_id"/>
        <result property="downBatchNo" column="batch_no"/>
        <result property="upBatchNo" column="up_batch_no"/>
        <result property="breed" column="breed"/>
        <result property="productType" column="product_type"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>

        <!-- 多对一：一个下游零售商对应多条下游批号 -->
        <association property="downNode" javaType="com.gec.seafood_traceability_system.pojo.NodeInfo">
            <id property="nodeId" column="n_node_id"/>
            <result property="name" column="n_name"/>
            <result property="code" column="n_code"/>
            <result property="address" column="n_address"/>
            <result property="corporation" column="n_corporation"/>
            <result property="telephone" column="n_telephone"/>
            <result property="businessId" column="n_business_id"/>
        </association>
    </resultMap>

    <select id="selectDownConfirmList" resultMap="DownConfirmMap">
        SELECT b.whol_batch_id,
               b.node_id,
               b.batch_no,
               b.up_batch_no,
               b.breed,
               b.product_type,
               b.status,
               b.create_time,
               n.node_id      AS n_node_id,
               n.name         AS n_name,
               n.code         AS n_code,
               n.address      AS n_address,
               n.corporation  AS n_corporation,
               n.telephone    AS n_telephone,
               n.business_id  AS n_business_id
        FROM whol_batch b
                 LEFT JOIN node_info n ON n.node_id = b.node_id
        WHERE b.status = 2
          AND b.up_batch_no IN
        <foreach collection="upBatchNos" item="no" open="(" separator="," close=")">
            #{no}
        </foreach>
        <if test="downName != null and downName != ''">
            AND n.name LIKE CONCAT('%', #{downName}, '%')
        </if>
        ORDER BY b.create_time DESC
    </select>

</mapper>
