/** index.wxss **/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.page {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.chat-area {
  flex: 1;
  padding: 20rpx 0 0;
  box-sizing: border-box;
}

.messages {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 180rpx;
}

.message-row {
  display: flex;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.message-row.bot {
  justify-content: flex-start;
}

.message-row.user {
  justify-content: flex-end;
}

.bubble {
  max-width: 80%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  line-height: 1.5;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
  word-break: break-all;
}

.bubble-images {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.bubble-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

.bubble.bot {
  background: #f1f1f1;
  color: #333;
}

.bubble.user {
  background: #3a8dff;
  color: #fff;
}

.suggestion-wrapper {
  margin-top: 20rpx; /* 与机器人回复之间 20rpx 间距 */
}

.suggestion-label {
  /* 与上面气泡整体左边缘保持同一条线：和 .message-row 一样 20rpx 内边距 */
  padding: 0 0 0 20rpx;
  font-size: 26rpx;
  color: #777;
  margin-bottom: 10rpx; /* 与下面额外问题之间 10rpx 距离 */
}

.suggestion-row {
  /* 不使用 flex，避免发生意外居中 / 伸缩，只负责整体左缩进 */
  display: block;
  padding: 0 0 0 20rpx;      /* 与 .message-row 的 padding-left 一致 */
  box-sizing: border-box;
}

.suggestion-item {
  display: block;            /* 每个额外问题占一整行 */
  margin-top: 10rpx;         /* 额外问题之间的间距 */
}

.suggestion-btn {
  /* 行内块：宽度随文字收缩，由外层 .suggestion-item 控制一行一个 */
  display: inline-block;
  background: #fff;
  color: #444;
  /* 浅灰色边框 + 圆角矩形 radius=100 */
  border: 1rpx solid #e0e0e0;
  min-height: 56rpx;
  padding: 8rpx 20rpx; /* 收窄左右内边距，使框更贴近文字 */
  border-radius: 100rpx;
  margin: 0;
  width: auto !important; /* 宽度跟随内容，从左对齐，不拉满整行 */
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.4;
  text-align: left; /* 文字左对齐 */
  box-sizing: border-box;
}

.suggestion-btn::after {
  display: none;
}

.composer {
  position: sticky;
  bottom: 0;
  padding: 0 20rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: linear-gradient(180deg, rgba(247, 248, 250, 0) 0%, #f7f8fa 40%);
  box-sizing: border-box;
}

.pending-images {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  padding: 8rpx 0 12rpx;
  gap: 12rpx;
}

.pending-image-item {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.pending-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 100rpx;
  padding: 8rpx 8rpx 8rpx 16rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.06);
}

.more-btn {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #4a4a4a;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.more-icon {
  font-size: 24rpx;
  line-height: 1;
  color: #4a4a4a;
  font-weight: 300;
}

.chat-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

.chat-input::placeholder {
  color: #b0b0b0;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  margin-left: 10rpx;
  border-radius: 50%;
  flex: 0 0 72rpx; /* 固定宽度，避免被拉伸成椭圆 */
  min-width: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: none;
}

.send-btn::after {
  display: none;
}

.send-btn--disabled {
  background: #d4d7dd;
}

.send-btn--enabled {
  background: #3a8dff;
}

.send-icon {
  width: 36rpx;
  height: 36rpx;
}

/* 推荐商品区域 */
.product-recommend-wrapper {
  margin-top: 24rpx;
  padding: 0 20rpx;
}

.recommend-label {
  font-size: 28rpx;
  color: #0C34BA;
  margin-bottom: 20rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
}

.recommend-label::before {
  content: '🛍️';
  margin-right: 8rpx;
  font-size: 24rpx;
}

.product-recommend-list {
  white-space: nowrap;
  width: 100%;
  padding-bottom: 8rpx;
}

.product-recommend-item {
  display: inline-block;
  width: 260rpx;
  margin-right: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.1);
  vertical-align: top;
  transition: all 0.3s;
}

.product-recommend-item:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.product-recommend-item:last-child {
  margin-right: 0;
}

.product-recommend-img {
  width: 100%;
  height: 260rpx;
  object-fit: cover;
  background: #f5f5f5;
}

.product-recommend-info {
  padding: 20rpx;
}

.product-recommend-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
  line-height: 1.4;
}

.product-recommend-price {
  font-size: 32rpx;
  color: #0C34BA;
  font-weight: bold;
  line-height: 1;
}
