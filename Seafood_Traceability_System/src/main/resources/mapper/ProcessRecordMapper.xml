<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  冷冻加工工序记录 Mapper —— 数据层批量操作
  单表增删改查仍由 MyBatis-Plus BaseMapper 自动生成。
-->
<mapper namespace="com.gec.seafood_traceability_system.mapper.ProcessRecordMapper">

    <!--
      批量新增工序记录。
      一条批号常要一次录入清洗/分级/冷冻/包装整套工序，
      foreach 拼多值 INSERT 比循环单条省往返。

      useGeneratedKeys + keyProperty 回填自增主键，
      便于调用方插入后直接拿到 recordId（例如回填 batchNo 冗余列或返回给前端）。
    -->
    <insert id="insertBatch" useGeneratedKeys="true" keyProperty="recordId">
        INSERT INTO process_record
            (froz_batch_id, node_id, step, step_time, temperature, operator, remark)
        VALUES
        <foreach collection="records" item="r" separator=",">
            (#{r.frozBatchId}, #{r.nodeId}, #{r.step}, #{r.stepTime},
             #{r.temperature}, #{r.operator}, #{r.remark})
        </foreach>
    </insert>

</mapper>
