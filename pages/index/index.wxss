/** index.wxss **/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.page {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.chat-area {
  flex: 1;
  padding: 20rpx 0 0;
  box-sizing: border-box;
}

.messages {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 180rpx;
}

.message-row {
  display: flex;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.message-row.bot {
  justify-content: flex-start;
}

.message-row.user {
  justify-content: flex-end;
}

.bubble {
  max-width: 80%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  line-height: 1.5;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
  word-break: break-all;
}

.bubble.bot {
  background: #f1f1f1;
  color: #333;
}

.bubble.user {
  background: #3a8dff;
  color: #fff;
}

.suggestion-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.suggestion-btn {
  background: #fff;
  color: #444;
  border: 1rpx solid #e3e3e3;
  border-radius: 100rpx;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  line-height: 1;
}

.suggestion-btn::after {
  display: none;
}

.composer {
  position: sticky;
  bottom: 0;
  padding: 0 20rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: linear-gradient(180deg, rgba(247, 248, 250, 0) 0%, #f7f8fa 40%);
  box-sizing: border-box;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 100rpx;
  padding: 8rpx 8rpx 8rpx 20rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.06);
}

.chat-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

.chat-input::placeholder {
  color: #b0b0b0;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  margin-left: 10rpx;
  border-radius: 50%;
  background: #3a8dff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: none;
}

.send-btn::after {
  display: none;
}

.send-icon {
  width: 36rpx;
  height: 36rpx;
}
