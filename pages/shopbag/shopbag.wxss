/* pages/shopbag/shopbag.wxss */
.shopbag-container {
  min-height: 100vh;
  background-color: #f2f2f2;
  padding-bottom: 100rpx;
}

/* 空购物袋 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 0 40rpx;
}

.empty-icon {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.go-shopping-btn {
  margin-bottom: 20rpx;
  margin-top: -20rpx;
  align-self: flex-start;
  width: 300rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: #0C34BA;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: none;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 20rpx;
  margin-top: -10rpx;
}

.empty-tip {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 60rpx;
}

/* 购物袋内容 */
.cart-content {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f2f2f2;
}

/* 顶部栏 */
.top-bar {
  background-color: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.clear-cart-btn {
  font-size: 26rpx;
  color: #999;
  padding: 10rpx 20rpx;
}

.cart-list {
  flex: 1;
  padding: 20rpx;
  background-color: #f2f2f2;
}

.cart-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

/* 勾选框样式 */
.item-checkbox {
  margin-right: 20rpx;
  padding: 10rpx;
  min-width: 60rpx;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #fff;
  position: relative;
}

.checkbox.checked {
  background-color: #0C34BA;
  border-color: #0C34BA;
}

.checkbox-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1;
  display: block;
}

.item-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 160rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.item-enname {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-price {
  font-size: 32rpx;
  color: #f00;
  font-weight: bold;
}

.item-count {
  display: flex;
  align-items: center;
}

.count-btn {
  width: 40rpx;
  height: 40rpx;
}

.count-value {
  min-width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  margin: 0 20rpx;
}

/* 底部结算栏 */
.checkout-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  border-top: 1px solid #eee;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.select-all-bottom {
  display: flex;
  align-items: center;
  margin-right: 30rpx;
}

.select-all-bottom .checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #fff;
  margin-right: 10rpx;
}

.select-all-bottom .checkbox.checked {
  background-color: #0C34BA;
  border-color: #0C34BA;
}

.select-all-bottom .checkbox-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  line-height: 1;
  display: block;
}

.select-all-text {
  font-size: 28rpx;
  color: #333;
}

.total-info {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  margin-right: 20rpx;
}

.total-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 10rpx;
}

.total-price {
  font-size: 36rpx;
  color: #f00;
  font-weight: bold;
}

.checkout-btn {
  width: 200rpx;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  background-color: #0C34BA;
  color: #fff;
  border-radius: 35rpx;
  font-size: 28rpx;
  font-weight: bold;
}
