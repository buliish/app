<!--pages/orders/orders.wxml-->
<view class="orders-container">
  <!-- 订单状态标签 -->
  <view class="status-tabs">
    <view 
      class="tab-item {{currentStatus === item.value ? 'active' : ''}}"
      wx:for="{{statusTabs}}" 
      wx:key="value"
      bindtap="switchStatus"
      data-status="{{item.value}}"
    >
      {{item.label}}
    </view>
  </view>

  <!-- 订单列表 -->
  <scroll-view class="orders-list" scroll-y>
    <view class="order-item" wx:for="{{orderList}}" wx:key="id">
      <!-- 订单头部 -->
      <view class="order-header">
        <text class="order-no">订单号：{{item.orderNo}}</text>
        <text class="order-status {{item.status}}">{{item.statusText}}</text>
      </view>

      <!-- 商品列表 -->
      <view class="order-products">
        <view class="product-item" wx:for="{{item.products}}" wx:key="pid" wx:for-item="product">
          <image class="product-img" src="{{product.smallImg}}" mode="aspectFill"></image>
          <view class="product-info">
            <view class="product-name">{{product.name}}</view>
            <view class="product-spec">
              <text class="product-price">¥{{product.price}}</text>
              <text class="product-count">x{{product.count}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 订单信息 -->
      <view class="order-info">
        <text class="order-time">{{item.createTime}}</text>
        <view class="order-total">
          <text class="total-label">合计：</text>
          <text class="total-price">¥{{item.totalPrice}}</text>
        </view>
      </view>

      <!-- 收货地址 -->
      <view class="order-address" wx:if="{{item.address}}">
        <view class="address-header-row">
          <text class="address-label">收货地址：</text>
          <view 
            class="change-address-btn" 
            wx:if="{{item.status === 'pending'}}"
            bindtap="changeOrderAddress"
            data-id="{{item.id}}"
          >
            修改
          </view>
        </view>
        <text class="address-text">{{item.address.fullAddress || (item.address.regionText + ' ' + item.address.detailAddress)}}</text>
        <text class="address-name-phone">{{item.address.name}} {{item.address.phone}}</text>
      </view>

      <!-- 订单操作 -->
      <view class="order-actions">
        <button 
          class="action-btn" 
          wx:if="{{item.status === 'pending'}}"
          bindtap="payOrder"
          data-id="{{item.id}}"
        >
          去付款
        </button>
        <button 
          class="action-btn" 
          wx:if="{{item.status === 'delivering'}}"
          bindtap="confirmReceive"
          data-id="{{item.id}}"
        >
          确认收货
        </button>
        <button 
          class="action-btn" 
          wx:if="{{item.status === 'completed' || item.status === 'delivering'}}"
          bindtap="viewOrderDetail"
          data-id="{{item.id}}"
        >
          查看详情
        </button>
        <button 
          class="action-btn cancel-btn" 
          wx:if="{{item.status === 'pending'}}"
          bindtap="cancelOrder"
          data-id="{{item.id}}"
        >
          取消订单
        </button>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-orders" wx:if="{{orderList.length === 0}}">
      <image class="empty-icon" src="../../images/shopbag_bg.png" mode="aspectFit"></image>
      <text class="empty-text">暂无订单</text>
    </view>
  </scroll-view>
</view>

