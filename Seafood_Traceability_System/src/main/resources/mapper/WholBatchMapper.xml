<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  批发商产品批号 Mapper —— 关联查询部分
  单表增删改查仍由 MyBatis-Plus BaseMapper 自动生成，此处只写需要 JOIN 的查询。
-->
<mapper namespace="com.gec.seafood_traceability_system.mapper.WholBatchMapper">

    <!--
      下游进场确认列表：批发商的下游是零售商，故从 reta_batch 出发
      多对一 JOIN 出下游企业。多条零售批号可能归属同一家企业，
      用 <association> 一次映射，不做 N+1 的嵌套子查询。

      downName 是"下游企业名称"的模糊条件，是 join 出来的字段，
      必须在 SQL 里过滤（放到 Java 侧过滤会把分页/数量算错）。
    -->
    <resultMap id="downConfirmMap" type="com.gec.seafood_traceability_system.pojo.ConfirmVO">
        <id     property="id"          column="id"/>
        <result property="downNodeId"  column="down_node_id"/>
        <result property="downBatchNo" column="down_batch_no"/>
        <result property="upBatchNo"   column="up_batch_no"/>
        <result property="breed"       column="breed"/>
        <result property="productType" column="product_type"/>
        <result property="status"      column="status"/>
        <result property="createTime"  column="create_time"/>
        <association property="downNode"
                     javaType="com.gec.seafood_traceability_system.pojo.NodeInfo">
            <id     property="nodeId"      column="n_node_id"/>
            <result property="code"        column="n_code"/>
            <result property="name"        column="n_name"/>
            <result property="nodeType"    column="n_type"/>
            <result property="provId"      column="n_prov_id"/>
            <result property="cityId"      column="n_city_id"/>
            <result property="address"     column="n_address"/>
            <result property="businessId"  column="n_business_id"/>
            <result property="corporation" column="n_corporation"/>
            <result property="telephone"   column="n_telephone"/>
        </association>
    </resultMap>

    <select id="selectDownConfirmList" resultMap="downConfirmMap">
        SELECT r.reta_batch_id  AS id,
               r.node_id        AS down_node_id,
               r.batch_no       AS down_batch_no,
               r.up_batch_no    AS up_batch_no,
               r.breed          AS breed,
               r.product_type   AS product_type,
               r.status         AS status,
               r.create_time    AS create_time,
               n.node_id        AS n_node_id,
               n.code           AS n_code,
               n.name           AS n_name,
               n.type           AS n_type,
               n.prov_id        AS n_prov_id,
               n.city_id        AS n_city_id,
               n.address        AS n_address,
               n.business_id    AS n_business_id,
               n.corporation    AS n_corporation,
               n.telephone      AS n_telephone
        FROM reta_batch r
                 JOIN node_info n ON n.node_id = r.node_id
        WHERE r.status = 2
          AND r.up_batch_no IN
        <foreach collection="upBatchNos" item="batchNo" open="(" separator="," close=")">
            #{batchNo}
        </foreach>
        <if test="downName != null and downName != ''">
            AND n.name LIKE CONCAT('%', #{downName}, '%')
        </if>
        ORDER BY r.create_time DESC
    </select>

</mapper>
