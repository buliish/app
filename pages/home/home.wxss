/* 页面容器 */
.home-container {
  width: 100%;
  box-sizing: border-box;
  background-color: #f8f8f8;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 60rpx;
  padding: 16rpx 24rpx;
  margin: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}
.search-input {
  font-size: 28rpx;
  color: #333333;
  flex: 1; /* 占满剩余空间 */
  height: 100%;
}

/* 轮播组件 */
.swiper-wrap {
  width: 100%;
  height: 360rpx; /* 固定轮播高度 */
  margin: 0 auto;
}
.banner-img {
  width: 100%;
  height: 100%;
  object-fit: cover; /* 覆盖模式，避免变形 */
}

/* 商品网格布局 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}
.product-item {
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx;
}

/* 空数据提示 */
.empty-tip {
  width: 100%;
  text-align: center;
  font-size: 28rpx;
  color: #999;
  padding: 40rpx 0;
}