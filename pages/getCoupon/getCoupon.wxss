/* pages/getCoupon/getCoupon.wxss */
.get-coupon-container {
  min-height: 100vh;
  background: #F5F6FA;
}

/* 累计消费金额头部 */
.spent-header {
  position: relative;
  padding: 60rpx 32rpx 40rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #0C34BA 0%, #1a4fd4 100%);
}

.header-bg::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.header-bg::after {
  content: '';
  position: absolute;
  bottom: -150rpx;
  left: -150rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
  text-align: center;
  color: #fff;
}

.spent-title {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 20rpx;
  font-weight: 400;
}

.spent-amount {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 16rpx;
}

.amount-symbol {
  font-size: 40rpx;
  margin-right: 8rpx;
  font-weight: 600;
}

.amount-value {
  font-size: 88rpx;
  font-weight: bold;
  line-height: 1;
  letter-spacing: -2rpx;
}

.spent-desc {
  font-size: 24rpx;
  opacity: 0.85;
}

/* 优惠券列表 */
.coupons-scroll {
  height: calc(100vh - 280rpx);
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.coupon-item {
  margin-bottom: 24rpx;
  animation: fadeInUp 0.4s ease-out;
  animation-fill-mode: both;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.coupon-item:nth-child(1) { animation-delay: 0.05s; }
.coupon-item:nth-child(2) { animation-delay: 0.1s; }
.coupon-item:nth-child(3) { animation-delay: 0.15s; }
.coupon-item:nth-child(4) { animation-delay: 0.2s; }

.coupon-card {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  overflow: visible;
  position: relative;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.coupon-card.can-receive {
  box-shadow: 0 8rpx 32rpx rgba(12, 52, 186, 0.2);
  transform: translateY(-4rpx);
  border: 2rpx solid #0C34BA;
}

.coupon-card.locked {
  opacity: 0.7;
}

.coupon-card.received {
  opacity: 0.6;
  background: #FAFAFA;
}

/* 左侧金额区域 */
.coupon-left {
  width: 240rpx;
  min-width: 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #0C34BA 0%, #1a4fd4 100%);
  color: #fff;
  padding: 40rpx 20rpx;
  border-radius: 24rpx 0 0 24rpx;
  position: relative;
}

.coupon-card.locked .coupon-left {
  background: linear-gradient(135deg, #999 0%, #AAA 0%);
}

.coupon-card.received .coupon-left {
  background: linear-gradient(135deg, #BBB 0%, #CCC 0%);
}

.coupon-amount {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 8rpx;
}

.amount-symbol {
  font-size: 28rpx;
  margin-right: 4rpx;
  font-weight: 600;
}

.amount-value {
  font-size: 72rpx;
  font-weight: bold;
  line-height: 1;
  letter-spacing: -2rpx;
}

.amount-desc {
  font-size: 22rpx;
  opacity: 0.95;
  font-weight: 400;
  text-align: center;
}

/* 中间虚线分割 */
.coupon-divider {
  width: 2rpx;
  position: relative;
  background: transparent;
}

.divider-line {
  width: 2rpx;
  height: 100%;
  background: repeating-linear-gradient(
    to bottom,
    #E0E0E0 0,
    #E0E0E0 8rpx,
    transparent 8rpx,
    transparent 16rpx
  );
  margin: 0 auto;
}

.divider-dot {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 20rpx;
  background: #F5F6FA;
  border-radius: 50%;
}

.divider-dot.top {
  top: -10rpx;
}

.divider-dot.bottom {
  bottom: -10rpx;
}

/* 右侧信息区域 */
.coupon-right {
  flex: 1;
  padding: 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 200rpx;
}

.coupon-header {
  margin-bottom: 20rpx;
}

.coupon-name-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.coupon-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  flex: 1;
}

.status-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
}

.icon-text {
  font-size: 28rpx;
}

.lock-icon {
  opacity: 0.6;
}

.unlock-icon {
  animation: sparkle 2s ease-in-out infinite;
}

@keyframes sparkle {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.8;
  }
}

.coupon-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

/* 解锁进度条 */
.unlock-progress {
  margin: 20rpx 0;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-label {
  font-size: 24rpx;
  color: #666;
}

.progress-percent {
  font-size: 24rpx;
  color: #0C34BA;
  font-weight: bold;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background-color: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #0C34BA 0%, #1a4fd4 100%);
  border-radius: 6rpx;
  transition: width 0.6s ease-out;
  position: relative;
}

.progress-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  animation: shimmer 2s infinite;
}

@keyframes shimmer {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}

.progress-text {
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}

/* 已解锁提示 */
.unlocked-tip {
  margin: 16rpx 0;
  padding: 12rpx 16rpx;
  background: linear-gradient(135deg, rgba(12, 52, 186, 0.1) 0%, rgba(26, 79, 212, 0.1) 100%);
  border-radius: 12rpx;
  border-left: 4rpx solid #0C34BA;
}

.tip-text {
  font-size: 24rpx;
  color: #0C34BA;
  font-weight: 500;
}

/* 已领取提示 */
.received-tip {
  margin: 16rpx 0;
  padding: 12rpx 16rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
}

.received-tip .tip-text {
  font-size: 24rpx;
  color: #999;
}

/* 领取按钮 */
.receive-btn-wrapper {
  margin-top: 8rpx;
}

.receive-btn {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 38rpx;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  transition: all 0.3s;
}

.receive-btn::after {
  border: none;
}

.receive-btn.active {
  background: linear-gradient(135deg, #0C34BA 0%, #1a4fd4 100%);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(12, 52, 186, 0.35);
}

.receive-btn.active:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(12, 52, 186, 0.25);
}

.receive-btn.disabled {
  background-color: #E8E8E8;
  color: #999;
}

.receive-btn.disabled:active {
  opacity: 0.7;
}

/* 空状态 */
.empty-coupons {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}

