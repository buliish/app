
<!--菜单-->
<view class="menu">

<!--搜索功能-->
<view class="search-box">
  <view class="search-ipt-box">
    <view class="search-icon">
      <image class="auto-img" src="../../images/home.png" mode="widthFix"/>
    </view>
    <input class="search-ipt" type="text" placeholder="请输入商品名称"/>
  </view>
</view>

<!--商品类型和列表-->
<view class="menu-content">

  <!--商品类型-->
  <view class="type">
    <view class="type-item {{selectedTypeIndex == index ? 'active' : ''}}" wx:for="{{typeData}}" wx:key="index" bind:tap="toggleType" data-index="{{index}}">
      {{item.type}}
      <view class="line"></view>
    </view>  
  </view>

  <!--商品列表-->
  <view class="list">
      <view class="list-box">
        <view class="list-item" wx:for="{{productData}}" wx:key="index">
          <Product pro-data="{{item}}"></Product>
        </view>
      </view>
  </view>

</view>

</view>