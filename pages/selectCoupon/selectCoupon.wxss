/* pages/selectCoupon/selectCoupon.wxss */
.select-coupon-container {
  min-height: 100vh;
  background-color: #f2f2f2;
  display: flex;
  flex-direction: column;
}

.header {
  background-color: #fff;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f2f2f2;
}

.title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.no-coupon-btn {
  font-size: 28rpx;
  color: #0C34BA;
}

.coupon-list {
  flex: 1;
  padding: 20rpx;
}

.coupon-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  position: relative;
  border: 2rpx solid transparent;
}

.coupon-item.selected {
  border-color: #0C34BA;
}

.coupon-item.disabled {
  opacity: 0.5;
}

.coupon-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  padding-right: 30rpx;
  border-right: 2rpx dashed #e0e0e0;
}

.coupon-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 10rpx;
}

.amount-symbol {
  font-size: 24rpx;
  color: #f00;
  font-weight: bold;
}

.amount-value {
  font-size: 48rpx;
  color: #f00;
  font-weight: bold;
}

.coupon-type {
  font-size: 20rpx;
  color: #999;
}

.coupon-right {
  flex: 1;
  padding-left: 30rpx;
  display: flex;
  flex-direction: column;
}

.coupon-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.coupon-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.coupon-expire {
  font-size: 22rpx;
  color: #999;
}

.coupon-condition {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #f00;
}

.coupon-check {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #0C34BA;
  display: flex;
  align-items: center;
  justify-content: center;
}

.coupon-check text {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.empty-coupon {
  text-align: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: #999;
}

.footer {
  background-color: #fff;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f2f2f2;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  background-color: #0C34BA;
  color: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.confirm-btn::after {
  border: none;
}

